# PICC web measurement tool — configuration
# Copy to `.env` and edit. `.env` is git-ignored.

# --- Initial administrator -------------------------------------------------
# Created only when no administrator account exists yet. A password change is
# forced at first login.
#
# SET THIS BEFORE FIRST RUN. If left empty the application refuses to start
# rather than fall back to a guessable default.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=

# --- Server ---------------------------------------------------------------
# 0.0.0.0 exposes the tool to the local network. Keep it on 127.0.0.1 unless
# you intend that, and open the firewall deliberately.
WEBAPP_HOST=127.0.0.1
WEBAPP_PORT=1531

# --- Data location --------------------------------------------------------
# Source DICOM files accumulate to several GB. Absolute path to move the store
# elsewhere; empty means ./data
DATA_DIR=

# --- Session signing key --------------------------------------------------
# Empty means a key is generated into data/secret_key.txt and reused, so
# sessions survive a restart.
SECRET_KEY=

# --- AI inference (optional) ----------------------------------------------
# Inference runs in a SEPARATE virtualenv: this app needs numpy 2.x + pydicom
# 3.x, while the detection models need torch and ~3 GB of CUDA libraries.
# Leave empty to disable the AI-measurement feature; everything else works.
INFER_PYTHON=
INFER_SCRIPT=

# --- Display strings ------------------------------------------------------
APP_TITLE=PICC 계측 라벨링
STUDY_TITLE=
